pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

contract SolarVault {
    IERC20 public paymentToken;
    uint256 public totalShares;
    mapping(address => uint256) public shares;

    event Deposited(address indexed investor, uint256 amount);
    event YieldClaimed(address indexed investor, uint256 amount);

    constructor(address _paymentToken) {
        paymentToken = IERC20(_paymentToken);
    }

    // Investors deposit USDC to buy shares of the solar farm
    function deposit(uint256 _amount) external {
        require(_amount > 0, "Amount must be > 0");
        require(paymentToken.transferFrom(msg.sender, address(this), _amount), "Transfer failed");
        
        shares[msg.sender] += _amount;
        totalShares += _amount;
        emit Deposited(msg.sender, _amount);
    }

    // Investors claim their proportional yield (USDC generated by energy sales)
    function claimYield() external {
        uint256 userShares = shares[msg.sender];
        require(userShares > 0, "No shares");
        
        uint256 vaultBalance = paymentToken.balanceOf(address(this));
        // Calculate the user's proportional specific portion
        uint256 payout = (vaultBalance * userShares) / (totalShares + 1); 
        
        require(payout > 0, "No yield to claim");
        
        // Burn shares to prevent double claiming
        shares[msg.sender] -= userShares; 
        totalShares -= userShares;

        require(paymentToken.transfer(msg.sender, payout), "Transfer failed");
        emit YieldClaimed(msg.sender, payout);
    }
}
